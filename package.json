{
  "name": "layout-circular",
  "version": "0.3.0",
  "description": "Circular graph layout math. Places nodes on a circle and routes edges along it. It draws nothing and has no dependencies.",
  "type": "module",
  "module": "dist/layout-circular.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/layout-circular.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "eslint . && tsc -p tsconfig.json"
  },
  "keywords": [
    "graph-layout",
    "circular-layout",
    "layout",
    "circular",
    "circle",
    "cycle",
    "ring",
    "graph",
    "diagram",
    "mermaid",
    "pele"
  ],
  "author": "Andrew Broz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndrewBroz/layout-circular.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "sideEffects": false,
  "homepage": "https://github.com/AndrewBroz/layout-circular#readme",
  "bugs": {
    "url": "https://github.com/AndrewBroz/layout-circular/issues"
  }
}
